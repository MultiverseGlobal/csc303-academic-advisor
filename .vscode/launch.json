{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Academic Advisor Web App",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.app:app", "--reload", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Python: Train Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/model_trainer.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Run Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests"],
      "console": "integratedTerminal"
    }
  ]
}
